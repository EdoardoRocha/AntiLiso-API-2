# Ambiente local / Docker
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antiliso?schema=public"
JWT_SECRET="change-me-in-production-min-32-chars-secret"
CORS_ORIGIN="http://localhost:3000"

# Deploy na Vercel (configure em Settings -> Environment Variables):
# NODE_ENV="production"
# DATABASE_URL="postgresql://usuario:senha@host-externo:5432/banco?sslmode=require" (use URL gerenciada com SSL/pooler, nunca localhost)
# JWT_SECRET="chave-aleatoria-segura-com-no-minimo-32-caracteres"
# CORS_ORIGIN="https://seu-frontend.vercel.app" (URL pública do Frontend, sem barra final "/")
